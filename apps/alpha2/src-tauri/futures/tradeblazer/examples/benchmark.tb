// TradeBlazer Benchmark Strategy
// ----------------------------------------
// 该脚本用于基准测试解释器执行性能，模拟高频策略在每个 Tick 上的密集计算。
// 特性：
//   * 使用数组 + 序列保存滑动窗口数据
//   * 组合多种指标/统计量（均值、波动率、价差、成交量偏差）
//   * 通过 managePosition 实现双向开平仓逻辑
//   * 在每个 Tick 内包含多重循环与条件，制造稳定且可重复的负载

var strategy_name = "Benchmark HFT Microstructure";
var lookback_fast = 6;
var lookback_slow = 32;
var volatility_window = 48;
var trade_threshold = 1.6;
var max_position = 3;
var max_buffer = 256;

series price_window;
series delta_window;

var alpha_scores[256];
var weight_profile[256];

var position = 0;
var last_price = 0.0;
var total_pnl = 0.0;
var trade_count = 0;
var heartbeat = 0;

function OnInit() {
    WarmupWeights();
}

function OnBar() {
    price_window = Close;
    delta_window = Close - Open;
}

function OnTick() {
    price_window = Close;
    delta_window = Close - Open;

    var depth = length(price_window);
    if (depth < lookback_slow) {
        last_price = Close;
        return;
    }

    var fast_mean = RollingMean(price_window, lookback_fast);
    var slow_mean = RollingMean(price_window, lookback_slow);
    var spread = fast_mean - slow_mean;

    var volatility = RollingVolatility(price_window, volatility_window);
    var imbalance = UpdateAlphaProfile(Close, Volume, High, Low);
    var micro_trend = (Close - Open) + (Close - last_price);
    var guard = trade_threshold * (volatility + 0.0001);

    if (last_price != 0) {
        total_pnl = total_pnl + position * (Close - last_price);
    }

    var signal = spread + micro_trend + imbalance / (max_buffer + 1);
    ManagePosition(signal, guard, Close);

    last_price = Close;
    heartbeat = heartbeat + 1;
}

function WarmupWeights() {
    var i = 0;
    var ratio = 0.0;
    var taper = 0.0;
    for (i = 0; i < max_buffer; i = i + 1) {
        ratio = i / max_buffer;
        if (ratio > 1) {
            ratio = 1;
        }
        taper = 1.0 - ratio;
        if (taper < 0) {
            taper = 0;
        }
        weight_profile[i] = taper;
        alpha_scores[i] = 0.0;
    }
}

function RollingMean(series data, var window) {
    var len = length(data);
    if (len == 0) {
        return 0;
    }
    if (window > len) {
        window = len;
    }

    var sum = 0.0;
    var i = 0;
    for (i = 0; i < window; i = i + 1) {
        sum = sum + data[i];
    }

    if (window == 0) {
        return 0;
    }
    return sum / window;
}

function RollingVolatility(series data, var window) {
    var len = length(data);
    if (len == 0) {
        return 0;
    }
    if (window > len) {
        window = len;
    }

    var mean = RollingMean(data, window);
    var sum_sq = 0.0;
    var i = 0;
    var diff = 0.0;
    for (i = 0; i < window; i = i + 1) {
        diff = data[i] - mean;
        sum_sq = sum_sq + diff * diff;
    }

    if (window == 0) {
        return 0;
    }
    return Sqrt(sum_sq / window);
}

function UpdateAlphaProfile(var price, var tick_volume, var high_price, var low_price) {
    var available = length(delta_window);
    if (available > max_buffer) {
        available = max_buffer;
    }
    if (available == 0) {
        return 0;
    }

    if (tick_volume > available) {
        tick_volume = available;
    }
    if (tick_volume < 0) {
        tick_volume = 0;
    }

    var price_depth = length(price_window);
    if (price_depth > max_buffer) {
        price_depth = max_buffer;
    }

    var imbalance_sum = 0.0;
    var i = 0;
    var momentum = 0.0;
    var weight = 0.0;
    var distance = 0.0;
    var alpha = 0.0;
    for (i = 0; i < available; i = i + 1) {
        momentum = delta_window[i];
        weight = weight_profile[i];
        distance = 0.0;
        if (i < price_depth) {
            distance = price_window[i] - price;
        }

        alpha = momentum * weight + distance * 0.35;
        if (i < tick_volume) {
            alpha = alpha + (high_price - low_price) * 0.1;
        }

        alpha_scores[i] = alpha;
        imbalance_sum = imbalance_sum + alpha;
    }

    return imbalance_sum;
}

function ManagePosition(var signal, var guard, var price) {
    if (signal > guard) {
        if (position < max_position) {
            Buy(price, 1);
            position = position + 1;
            trade_count = trade_count + 1;
        }
    } else if (signal < -guard) {
        if (position > -max_position) {
            Sell(price, 1);
            position = position - 1;
            trade_count = trade_count + 1;
        }
    } else {
        var calm = guard * 0.35;
        if (Abs(signal) < calm && position != 0) {
            if (position > 0) {
                ExitLong(price, position);
            }
            if (position < 0) {
                ExitShort(price, -position);
            }
            position = 0;
        }
    }
}
