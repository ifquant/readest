{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "futureass",
  "version": "0.1.0",
  "identifier": "com.dev.futureass",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
          {
            "label": "main",
            "title": "主窗口",
            "width": 1000,
            "height": 800,
            "resizable": true,
            "center": true
          }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:1420 https://passport.weibo.com https://weibo.cn https://*.weibo.com https://*.sina.cn; frame-src https://passport.weibo.com https://weibo.cn https://*.weibo.com https://*.sina.cn;"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}


