# Normalize line endings for text files.
* text=auto eol=lf

# Windows scripts should stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Mark binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.7z binary
*.tar binary
*.gz binary
